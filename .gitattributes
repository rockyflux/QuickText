# Normalize line endings: text files are stored as LF in the repo regardless of a contributor's
# OS or core.autocrlf setting, so line endings never churn across platforms.
* text=auto

# Binary assets — never apply text/EOL conversion.
*.png binary
*.ico binary

# auto generated by UGit 
*.dll filter=lfs diff=lfs merge=binary -text
*.png filter=lfs diff=lfs merge=binary -text
*.exe filter=lfs diff=lfs merge=binary -text
*.pdb filter=lfs diff=lfs merge=binary -text
*.resources filter=lfs diff=lfs merge=binary -text
*.cache filter=lfs diff=lfs merge=binary -text
*.ico filter=lfs diff=lfs merge=binary -text

