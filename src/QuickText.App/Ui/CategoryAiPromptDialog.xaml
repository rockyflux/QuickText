<Window x:Class="QuickText.App.Ui.CategoryAiPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="560" MinWidth="480" MinHeight="360" MaxHeight="900"
        ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WinBg}" FontFamily="{StaticResource Font.Ui}">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" x:Name="HintText" FontSize="11.5" Margin="0,4,0,10"
                   Foreground="{DynamicResource Brush.TextFaint}" TextWrapping="Wrap"/>

        <TextBox Grid.Row="2" x:Name="PromptBox" Style="{StaticResource DarkTextBox}"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Padding="10,8"
                 AutomationProperties.LabeledBy="{Binding ElementName=HintText}"/>

        <TextBlock Grid.Row="3" x:Name="StatusText" FontSize="12" Margin="0,8,0,0"
                   Foreground="{DynamicResource Brush.Accent}" Visibility="Collapsed" TextWrapping="Wrap"/>

        <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,14,0,-6">
            <Button x:Name="CloseButton" Style="{StaticResource DarkButton}" MinWidth="84" Padding="16,7"
                    Margin="0,0,10,6" IsCancel="True" Click="OnClose"/>
            <Button x:Name="CopyButton" Style="{StaticResource DarkButtonPrimary}" MinWidth="84" Padding="16,7"
                    Margin="0,0,0,6" IsDefault="True" Click="OnCopy"/>
        </WrapPanel>
    </Grid>
</Window>
