<Window x:Class="QuickText.App.Ui.CategoryBatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.WinBg}" FontFamily="{StaticResource Font.Ui}"
        MaxHeight="560">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="160"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.TextPrimary}"/>
        <TextBlock Grid.Row="1" x:Name="HintText" FontSize="11.5" Margin="0,6,0,10"
                   Foreground="{DynamicResource Brush.TextFaint}" TextWrapping="Wrap"/>
        <TextBox Grid.Row="2" x:Name="NamesBox" Style="{StaticResource DarkTextBox}"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 MinHeight="160" FontSize="13.5" Padding="10,8"
                 AutomationProperties.LabeledBy="{Binding ElementName=HintText}"/>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,14,0,-6">
            <Button x:Name="CancelButton" Style="{StaticResource DarkButton}" MinWidth="84" Padding="16,7"
                    Margin="0,0,10,6" IsCancel="True" Click="OnCancel"/>
            <Button x:Name="OkButton" Style="{StaticResource DarkButtonPrimary}" MinWidth="84" Padding="16,7"
                    Margin="0,0,0,6" IsDefault="True" Click="OnOk"/>
        </WrapPanel>
    </Grid>
</Window>
