<Window x:Class="QuickText.App.Ui.AiConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:QuickText.App"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.WinBg}" FontFamily="{StaticResource Font.Ui}"
        MaxHeight="640"
        Title="{Binding [Settings.AiEditTitle], Source={x:Static app:LocProxy.Instance}}">
    <!-- SizeToContent + MaxHeight + CapHeightToMonitor: title/actions stay outside the scroll body. -->
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel Style="{StaticResource SetField}">
                    <TextBlock x:Name="NameLabel" Text="{Binding [Settings.AiName], Source={x:Static app:LocProxy.Instance}}"
                               Style="{StaticResource SetFieldLabel}"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource DarkTextBox}" FontSize="14"
                             AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource SetField}">
                    <TextBlock x:Name="ProviderLabel" Text="{Binding [Settings.AiProvider], Source={x:Static app:LocProxy.Instance}}"
                               Style="{StaticResource SetFieldLabel}"/>
                    <ComboBox x:Name="ProviderCombo" Style="{StaticResource DarkComboBox}"
                              AutomationProperties.LabeledBy="{Binding ElementName=ProviderLabel}"
                              SelectedValuePath="Id" HorizontalAlignment="Stretch"
                              SelectionChanged="OnProviderChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Style="{StaticResource SetField}">
                    <TextBlock x:Name="ApiKeyLabel" Text="{Binding [Settings.AiApiKey], Source={x:Static app:LocProxy.Instance}}"
                               Style="{StaticResource SetFieldLabel}"/>
                    <PasswordBox x:Name="ApiKeyBox" FontSize="14" Padding="10,8"
                                 Background="{DynamicResource Brush.InputBg}"
                                 Foreground="{DynamicResource Brush.TextPrimary}"
                                 BorderBrush="{DynamicResource Brush.InputBorder}" BorderThickness="1"
                                 AutomationProperties.LabeledBy="{Binding ElementName=ApiKeyLabel}"/>
                    <TextBlock Style="{StaticResource SetHint}"
                               Text="{Binding [Settings.AiApiKeyHint], Source={x:Static app:LocProxy.Instance}}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource SetField}">
                    <TextBlock x:Name="BaseUrlLabel" Text="{Binding [Settings.AiBaseUrl], Source={x:Static app:LocProxy.Instance}}"
                               Style="{StaticResource SetFieldLabel}"/>
                    <Grid>
                        <TextBox x:Name="BaseUrlBox" Style="{StaticResource DarkTextBox}" FontSize="13"
                                 FontFamily="{StaticResource Font.Mono}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=BaseUrlLabel}"
                                 TextChanged="OnBaseUrlTextChanged"/>
                        <!-- Same overlay pattern as Settings data-folder: placeholder vanishes once typed. -->
                        <TextBlock x:Name="BaseUrlPlaceholder" Margin="10,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource Font.Mono}" FontSize="13"
                                   Foreground="{DynamicResource Brush.TextFaint}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=BaseUrlBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Style="{StaticResource SetHint}"
                               Text="{Binding [Settings.AiBaseUrlHint], Source={x:Static app:LocProxy.Instance}}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource SetField}" Margin="0">
                    <TextBlock x:Name="ModelLabel" Text="{Binding [Settings.AiModel], Source={x:Static app:LocProxy.Instance}}"
                               Style="{StaticResource SetFieldLabel}"/>
                    <ComboBox x:Name="ModelCombo" Style="{StaticResource DarkComboBox}"
                              IsEditable="True" IsTextSearchEnabled="True"
                              StaysOpenOnEdit="True" FontFamily="{StaticResource Font.Mono}" FontSize="13"
                              AutomationProperties.LabeledBy="{Binding ElementName=ModelLabel}"/>
                    <TextBlock x:Name="ModelStatus" Style="{StaticResource SetHint}" Margin="2,4,0,0"/>
                    <TextBlock Style="{StaticResource SetHint}"
                               Text="{Binding [Settings.AiModelHint], Source={x:Static app:LocProxy.Instance}}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,14,0,-6">
            <Button x:Name="CancelButton" Style="{StaticResource DarkButton}" MinWidth="84" Padding="16,7"
                    Margin="0,0,10,6" IsCancel="True" Click="OnCancel"
                    Content="{Binding [Dialog.Cancel], Source={x:Static app:LocProxy.Instance}}"/>
            <Button x:Name="OkButton" Style="{StaticResource DarkButtonPrimary}" MinWidth="84" Padding="16,7"
                    Margin="0,0,0,6" IsDefault="True" Click="OnOk"
                    Content="{Binding [Dialog.OK], Source={x:Static app:LocProxy.Instance}}"/>
        </WrapPanel>
    </Grid>
</Window>
