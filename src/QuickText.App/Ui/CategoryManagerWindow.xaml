<Window x:Class="QuickText.App.Ui.CategoryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:QuickText.App"
        Title="{Binding [CatMgr.Title], Source={x:Static app:LocProxy.Instance}}"
        Width="620" Height="680" MinWidth="520" MinHeight="440" MaxHeight="900"
        ResizeMode="CanResize" ShowInTaskbar="True"
        Background="{DynamicResource Brush.WinBg}" FontFamily="{StaticResource Font.Ui}">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.TextPrimary}"/>
        <TextBlock Grid.Row="1" x:Name="HintText" FontSize="11.5" Margin="0,4,0,12"
                   Foreground="{DynamicResource Brush.TextFaint}" TextWrapping="Wrap"/>

        <Border Grid.Row="2" Style="{StaticResource SetCard}" Padding="10,10,10,10" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                    <Button Style="{StaticResource GhostIconButton}" Content="&#xE710;" Click="OnAddOne"
                            AutomationProperties.Name="{Binding [Manager.NewCategory], Source={x:Static app:LocProxy.Instance}}"
                            ToolTip="{Binding [Manager.NewCategory], Source={x:Static app:LocProxy.Instance}}"/>
                    <Button Style="{StaticResource GhostIconButton}" Content="&#xE70F;" Click="OnRename"
                            AutomationProperties.Name="{Binding [Manager.Rename], Source={x:Static app:LocProxy.Instance}}"
                            ToolTip="{Binding [Manager.Rename], Source={x:Static app:LocProxy.Instance}}"/>
                    <Button x:Name="OpenJsonButton" Style="{StaticResource GhostIconButton}" Content="&#xE8A5;"
                            Click="OnOpenJson"
                            AutomationProperties.Name="{Binding [CatMgr.OpenJson], Source={x:Static app:LocProxy.Instance}}"
                            ToolTip="{Binding [CatMgr.OpenJson], Source={x:Static app:LocProxy.Instance}}"/>
                    <Button Style="{StaticResource GhostIconButton}" Content="&#xE738;" Click="OnDelete"
                            AutomationProperties.Name="{Binding [Manager.Delete], Source={x:Static app:LocProxy.Instance}}"
                            ToolTip="{Binding [Manager.Delete], Source={x:Static app:LocProxy.Instance}}"/>
                </StackPanel>
                <ListBox Grid.Row="1" x:Name="Categories" ItemTemplate="{StaticResource CategoryRowTemplate}"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="OnListPressed" PreviewMouseMove="OnListMove" Drop="OnCategoriesDrop"
                         MouseDoubleClick="OnCategoryDoubleClick"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource DarkListItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnCategorySelected"/>
                <TextBlock Grid.Row="1" x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Foreground="{DynamicResource Brush.TextFaint}" Visibility="Collapsed"
                           IsHitTestVisible="False"/>
                <!-- Color first; sort sits after the swatches (wraps on a second line when narrow). -->
                <WrapPanel Grid.Row="2" Margin="4,10,0,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,9,6" VerticalAlignment="Center"
                               Text="{Binding [Manager.Color], Source={x:Static app:LocProxy.Instance}}"/>
                    <Button Style="{StaticResource ColorSwatch}" Background="Transparent" Tag="" Click="OnColor" Margin="0,0,10,6"/>
                    <Button Style="{StaticResource ColorSwatch}" Background="#3DC2A0" Tag="#3DC2A0" Click="OnColor" Margin="0,0,10,6"/>
                    <Button Style="{StaticResource ColorSwatch}" Background="#5B9BD5" Tag="#5B9BD5" Click="OnColor" Margin="0,0,10,6"/>
                    <Button Style="{StaticResource ColorSwatch}" Background="#A98CE8" Tag="#A98CE8" Click="OnColor" Margin="0,0,10,6"/>
                    <Button Style="{StaticResource ColorSwatch}" Background="#FF8A5B" Tag="#FF8A5B" Click="OnColor" Margin="0,0,10,6"/>
                    <Button Style="{StaticResource ColorSwatch}" Background="#E8C264" Tag="#E8C264" Click="OnColor" Margin="0,0,10,6"/>
                    <Button Style="{StaticResource ColorSwatch}" Background="#E87AA8" Tag="#E87AA8" Click="OnColor" Margin="0,0,10,6"/>
                    <TextBlock x:Name="SortLabel" Style="{StaticResource FieldLabel}"
                               Margin="18,0,9,6" VerticalAlignment="Center"
                               Text="{Binding [Manager.Sort], Source={x:Static app:LocProxy.Instance}}"/>
                    <ComboBox x:Name="SortCombo" Style="{StaticResource DarkComboBox}"
                              MinWidth="160" Margin="0,0,0,6" VerticalAlignment="Center"
                              SelectedValuePath="Tag"
                              AutomationProperties.LabeledBy="{Binding ElementName=SortLabel}"
                              SelectionChanged="OnSortModeChanged"/>
                </WrapPanel>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="3" Margin="0,14,0,0">
            <Button x:Name="BatchButton" Style="{StaticResource DarkButton}" Padding="14,7" Margin="0,0,8,6"
                    Click="OnBatchAdd"/>
            <Button x:Name="AiCreateButton" Style="{StaticResource DarkButton}" Padding="14,7" Margin="0,0,8,6"
                    Click="OnAiCreate"/>
            <Button x:Name="InitButton" Style="{StaticResource DarkButton}" Padding="14,7" Margin="0,0,0,6"
                    Click="OnInitialize" Visibility="Collapsed"/>
        </WrapPanel>

        <Button Grid.Row="4" x:Name="CloseButton" Style="{StaticResource DarkButton}"
                HorizontalAlignment="Right" Padding="14,7" Margin="0,14,0,0" Click="OnClose"/>
    </Grid>
</Window>
