<Window x:Class="QuickText.App.Ui.FloatingBallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:QuickText.App"
        Title="{Binding [App.Name], Source={x:Static app:LocProxy.Instance}}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" ResizeMode="NoResize"
        Width="52" Height="52"
        AutomationProperties.Name="{Binding [Tray.FloatBall], Source={x:Static app:LocProxy.Instance}}">
    <Window.ContextMenu>
        <ContextMenu Style="{StaticResource DarkContextMenu}" Opened="OnMenuOpened">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItem}"/>
                <Style TargetType="Separator" BasedOn="{StaticResource DarkMenuSeparator}"/>
            </ContextMenu.Resources>
            <MenuItem Click="OnOpenSearch">
                <MenuItem.Icon><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Brush.Accent}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="OnOpenManager">
                <MenuItem.Icon><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Brush.TextMuted}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="OnOpenCategoryManager">
                <MenuItem.Icon><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Brush.TextMuted}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="OnOpenSkills">
                <MenuItem.Icon><TextBlock Text="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Brush.TextMuted}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="OnNewFromClipboard">
                <MenuItem.Icon><TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Brush.TextMuted}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="OnSettings">
                <MenuItem.Icon><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Brush.TextMuted}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="OnTogglePause">
                <MenuItem.Icon><TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Brush.TextMuted}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Click="OnHide">
                <MenuItem.Icon><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Brush.TextMuted}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Click="OnExit">
                <MenuItem.Icon><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Brush.TextMuted}"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>
    <Border x:Name="Ball"
            CornerRadius="26"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Accent}"
            BorderThickness="2"
            Cursor="Hand"
            ToolTip="{Binding [Tray.FloatBall], Source={x:Static app:LocProxy.Instance}}"
            MouseLeftButtonDown="OnBallMouseDown"
            MouseMove="OnBallMouseMove"
            MouseLeftButtonUp="OnBallMouseUp">
        <!-- PNG, not the multi-size .ico: WPF Image often picks a tiny ICO frame and
             upscales it, which is what made the ball look soft. -->
        <Image Source="pack://application:,,,/Assets/quicktext-float.png"
               Width="28" Height="28"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="True"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               IsHitTestVisible="False"/>
    </Border>
</Window>
