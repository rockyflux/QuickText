<Window x:Class="QuickText.App.Ui.CategoryJsonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:QuickText.App"
        Width="720" Height="560" MinWidth="480" MinHeight="360" MaxHeight="900"
        ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource Brush.WinBg}" FontFamily="{StaticResource Font.Ui}">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" x:Name="HintText" FontSize="11.5" Margin="0,4,0,8"
                   Foreground="{DynamicResource Brush.TextFaint}" TextWrapping="Wrap"/>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PathLabel" Grid.Column="0" Style="{StaticResource FieldLabel}"
                       Margin="0,0,9,0" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="PathBox" Style="{StaticResource DarkTextBox}"
                     IsReadOnly="True" FontSize="12"
                     FontFamily="{StaticResource Font.Mono}"
                     VerticalContentAlignment="Center" Padding="8,6"
                     AutomationProperties.LabeledBy="{Binding ElementName=PathLabel}"/>
        </Grid>

        <TextBox Grid.Row="3" x:Name="JsonBox" Style="{StaticResource DarkTextBox}"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Padding="10,8"
                 AutomationProperties.LabeledBy="{Binding ElementName=HintText}"/>

        <TextBlock Grid.Row="4" x:Name="StatusText" FontSize="12" Margin="0,8,0,0"
                   Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>

        <DockPanel Grid.Row="5" Margin="0,14,0,0" LastChildFill="False">
            <WrapPanel DockPanel.Dock="Left">
                <Button x:Name="ReloadButton" Style="{StaticResource DarkButton}" Padding="14,7"
                        Margin="0,0,8,0" Click="OnReload"/>
                <Button x:Name="OpenExternalButton" Style="{StaticResource DarkButton}" Padding="14,7"
                        Margin="0,0,8,0" Click="OnOpenExternal"/>
                <Button x:Name="CopyPromptButton" Style="{StaticResource DarkButton}" Padding="14,7"
                        Click="OnCopyPrompt"/>
            </WrapPanel>
            <WrapPanel DockPanel.Dock="Right">
                <Button x:Name="CloseButton" Style="{StaticResource DarkButton}" Padding="14,7"
                        Margin="0,0,8,0" IsCancel="True" Click="OnClose"/>
                <Button x:Name="SaveButton" Style="{StaticResource DarkButtonPrimary}" Padding="14,7"
                        Click="OnSave"/>
            </WrapPanel>
        </DockPanel>
    </Grid>
</Window>
